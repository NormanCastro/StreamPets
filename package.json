{
  "name": "streampets",
  "private": true,
  "version": "0.2.0",
  "description": "StreamPets: mascotas animadas para overlays de Twitch (motor, servidor, overlay)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @streampets/sandbox dev",
    "dev:server": "pnpm --filter @streampets/server dev",
    "dev:overlay": "pnpm --filter @streampets/overlay dev",
    "dev:dashboard": "pnpm --filter @streampets/dashboard dev",
    "build:web": "pnpm --filter @streampets/overlay build && pnpm --filter @streampets/dashboard build",
    "simulate": "pnpm --filter @streampets/server simulate",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
