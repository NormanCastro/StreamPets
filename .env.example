# Copia a .env (o defínelo en Render). Ver README.
NODE_ENV=development
PORT=3000

# Postgres. Sin esto, en desarrollo se usa una base embebida (PGlite) en apps/server/data.
# En producción es obligatorio. Con la base interna de Render usa la "Internal Database URL".
# DATABASE_URL=postgres://user:pass@host:5432/streampets

# Clave del panel de administración (obligatoria en producción, 24+ caracteres).
# Genérala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_TOKEN=

# Canal al que pertenece esta instalación.
STREAMER_LOGIN=streamer
STREAMER_DISPLAY_NAME=Streamer

# Lectura del chat real de Twitch (solo lectura). Canal = TWITCH_CHANNEL o, si no está, STREAMER_LOGIN
# (hay que definir uno de los dos de forma explícita).
# TWITCH_CHAT_ENABLED=true
# TWITCH_CHANNEL=tucanal
# Opcional (modo oficial con token): cuenta y token OAuth con permiso chat:read. Van juntos.
# TWITCH_BOT_LOGIN=
# TWITCH_OAUTH_TOKEN=

# Entrar al panel con Twitch (varios streamers). Los tres van juntos o ninguno.
# Registra la app en https://dev.twitch.tv/console con esta "OAuth Redirect URL": PUBLIC_URL + /auth/twitch/callback
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=      # tratar como una contraseña: nunca en GitHub
# PUBLIC_URL=https://streampets.live    # https obligatorio (http solo en localhost para probar)
# SESSION_TTL_DAYS=14        # cuánto dura una sesión iniciada con Twitch

# Chat simulado (POST /api/admin/dev/chat). Por defecto: activo en desarrollo, apagado en producción.
# ENABLE_DEV_CHAT=true

# Orígenes que pueden llamar a la API desde un navegador (dashboard alojado aparte), separados por coma.
# ALLOWED_ORIGINS=https://tu-dashboard.onrender.com
